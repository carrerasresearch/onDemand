#!/bin/bash
# script.sh.erb
# This script is executed on the compute node.
# --- SETUP AND VARIABLES ---
# Define the local path where the token should exist

# Singularity Image Path
<%-
  # Version (form.yml vscode_version; the value is the description shown on
  # the session card) => SIF. New versions are added at the top by .github/release-bot.
  images = {
    "VS Code 1.144.0, Slurm client 20.11" => "/ijc/PUBLIC/DATA/images/vscode-tunnel_1.144.0.sif",
    "VS Code 1.116.0, Slurm client 20.11" => "/ijc/PUBLIC/DATA/images/vscode-tunnel.sif",
  }
  # Short values used before the descriptive ones (saved sessions).
  aliases = { "1.144.0" => "VS Code 1.144.0, Slurm client 20.11", "1.116.0" => "VS Code 1.116.0, Slurm client 20.11" }
  default = "VS Code 1.116.0, Slurm client 20.11"
  key = aliases.fetch(context.vscode_version.to_s, context.vscode_version.to_s)
  key = default unless images.key?(key)
-%>
SINGULARITY_IMAGE="<%= images[key] %>"
echo "Version <%= key %>: ${SINGULARITY_IMAGE}"
[[ -f "${OOD_CHECKS:-}" ]] && source "$OOD_CHECKS" && ood_check_image "$SINGULARITY_IMAGE"

echo "================================================="
echo "  Launching VS Code Tunnel via Singularity..."
echo "  Node:      $(hostname)"
echo "================================================="

# Load the singularity module
module load singularity
if [ $? -ne 0 ]; then
    echo "ERROR: Failed to load singularity module."
    exit 1
fi


# --- WRITE CONNECTION METADATA  ---
# Write the connection file immediately after launching the service.
# SESSION_DIR="<%= Dir.pwd %>"
#e cho "Session dir: $SESSION_DIR"

#cat > connection.yml <<END
#host: $(hostname -f)
#password: $SESSION_DIR  # Session path via password field
#END

# ---

# --- CONDITIONAL AUTHENTICATION CHECK ---

# Function to check the login status inside the container
# We capture the output and check if it contains the "not logged in" string.
LOGIN_STATUS=$(/usr/bin/env bash -c "singularity exec \
  $SINGULARITY_IMAGE \
  /usr/container/bin/code tunnel user show")

# Check if the output of 'code tunnel user show' indicates a logged-in state.
# If the output contains 'not logged in', the check fails (status needed).
if echo "$LOGIN_STATUS" | grep -q "not logged in"; then
    echo "Authentication status: NOT LOGGED IN. Running interactive login (Microsoft)."

    # Run the interactive login command. This will prompt the user for the device code.
    /usr/bin/env bash -c "singularity exec \
      $SINGULARITY_IMAGE \
      /usr/container/bin/code tunnel user login --provider microsoft"

    # Important: The user must complete the web authentication while this command is running.
    # A brief pause to ensure the token is written to disk after successful authentication.
    sleep 2
else
    # Output the current login status (e.g., "logged in with provider Microsoft Account")
    echo "Authentication status: $LOGIN_STATUS"
    echo "Stored credentials found and will be used."
fi


# --- SLURM CLIENT CONFIG FOR THE CONTAINER ---
# The image ships its own Slurm client (vscode-tunnel.def) with its plugins in
# /usr/lib/slurm. The node's slurm.conf sets PluginDir to the host's Slurm
# build under /opt, which is visible in the container through the /opt bind,
# and Slurm only loads plugins built for its exact version — so sbatch in a
# VS Code terminal failed with "Incompatible Slurm plugin version". Give the
# container a copy of the node's config without PluginDir so its clients use
# their own plugins. Jobs submitted from the container are unaffected: slurmd
# resets SLURM_CONF to the node's config for every job step.
HOST_SLURM_CONF="${SLURM_CONF:-/etc/slurm/slurm.conf}"
CONTAINER_SLURM_CONF="${PWD}/slurm.conf"
if sed -E '/^[[:space:]]*PluginDir[[:space:]]*=/Id' "$HOST_SLURM_CONF" > "$CONTAINER_SLURM_CONF"; then
    export SINGULARITYENV_SLURM_CONF="$CONTAINER_SLURM_CONF"
else
    # Not fatal: the tunnel still works for editing, only Slurm commands in
    # its terminals are affected.
    echo "WARNING: Cannot read Slurm config at ${HOST_SLURM_CONF}; sbatch in VS Code terminals may fail."
fi

# --- THE CLUSTER'S SLURM IN VS CODE TERMINALS ---
# ood_slurm.sh: sbatch, srun, ... run the cluster's own client (the version
# this node's slurmd runs, so it follows Slurm upgrades; the client built into
# the image only stays as a fallback), with the node's login environment, so
# jobs do not inherit the container's. Also ood-host.
OOD_SLURM_BIND=""; OOD_SLURM_PATH=""
[[ -f ./ood_slurm.sh ]] && source ./ood_slurm.sh && ood_slurm_setup "$SINGULARITY_IMAGE" "${OOD_SESSION_DIR:-$PWD}"
[[ -n "$OOD_SLURM_PATH" ]] && export SINGULARITYENV_PREPEND_PATH="$OOD_SLURM_PATH"
# Do not pass the host's `module` function into the container: the `module`
# on PATH there (ood_slurm.sh) offers the cluster modules tested in this image.
export -fn module ml 2>/dev/null || true

# --- LAUNCH TUNNEL SERVICE (Background) ---
# Launch the main tunnel service in the background (&).

echo "Launching VS Code Tunnel service..."

/usr/bin/env bash -c "singularity run \
  -B /etc/slurm:/etc/slurm     -B /var/run/munge:/var/run/munge     -B /usr/local/bin:/usr/local/bin    -B /opt:/opt     -B /ijc:/ijc \
  ${OOD_SLURM_BIND:+-B $OOD_SLURM_BIND} \
  $SINGULARITY_IMAGE" &

# Capture the process ID
TUNNEL_PID=$!

# --- 5. KEEP JOB ALIVE ---
# The 'wait' command prevents the script from exiting until the tunnel process finishes.
echo "Tunnel service launched in background (PID: $TUNNEL_PID). Waiting for job termination..."
wait $TUNNEL_PID

# --- 6. Cleanup and Exit ---
echo "================================================="
echo "VS Code Tunnel process exited or job reached walltime."
echo "================================================="
exit 0
