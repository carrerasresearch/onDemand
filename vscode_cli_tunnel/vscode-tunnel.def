# VS Code CLI (tunnel) + Slurm 20.11 client, for the OnDemand "VS Code Tunnel" app.
#
# Build:  apptainer build --fakeroot --build-arg VSCODE_VERSION=1.106.2 \
#             vscode-tunnel_1.106.2.sif vscode-tunnel.def
#         (VSCODE_VERSION=latest takes the newest stable release)
# Deploy: cp vscode-tunnel_<version>.sif /ijc/PUBLIC/DATA/images/ and point
#         template/script.sh.erb at it (.github/release-bot does both).

Bootstrap: docker
From: ubuntu:24.04

%arguments
    VSCODE_VERSION=latest

%post
    # Install dependencies and tools
    apt-get update
    apt-get install -y --no-install-recommends \
        curl wget tar git openssh-client libfuse2 libstdc++6 ca-certificates fuse3 gnupg procps build-essential \
        libmunge-dev libssl-dev libncurses-dev python3 libcurl4-openssl-dev make gcc libhwloc-dev libreadline-dev libpam-dev pkg-config
	
    # -----------------------------------------------------------
    # Descarga y Compilación de Slurm Cliente
    # -----------------------------------------------------------
    SLURM_VERSION="20.11.9"
    SLURM_DIR="slurm-${SLURM_VERSION}"

    # Add user slurm
    groupadd -r slurm || true
    useradd -r -g slurm -s /bin/bash slurm || true 

    echo "Descargando código fuente de Slurm ${SLURM_VERSION}..."
    # No coincide exactamente con el host (20.11.8): Slurm exige la misma versión
    # exacta para los plugins, así que template/script.sh.erb quita PluginDir del
    # slurm.conf del nodo y el cliente usa los plugins de esta build (/usr/lib/slurm).
    # Cualquier 20.11.x habla el mismo protocolo con el controlador.
    wget -q --timeout=60 --tries=5 "https://download.schedmd.com/slurm/slurm-${SLURM_VERSION}.tar.bz2" -O /tmp/slurm.tar.bz2

    mkdir -p /opt/${SLURM_DIR}
    tar -xf /tmp/slurm.tar.bz2 -C /opt/${SLURM_DIR} --strip-components 1
    rm /tmp/slurm.tar.bz2

    cd /opt/${SLURM_DIR}

    # Configuración de la compilación: solo necesitamos los clientes (no los demonios como slurmctld o slurmd)
    echo "Configurando la compilación solo para clientes..."
    ./configure \
       --prefix=/usr \
       --sysconfdir=/etc/slurm \
       --without-munge-include \
       --without-munge-lib

    # Compilación: "make" compila todos los componentes
    echo "Compilando Slurm..."
    make -j$(nproc)

    # Instalación: Solo instalamos los binarios del cliente (sbatch, srun, squeue, etc.)
    echo "Instalando los binarios del cliente en /usr/bin..."
    make install
    
    # -----------------------------------------------------------
    # Limpieza Final y Comprobación
    # -----------------------------------------------------------
    cd /
    rm -rf /opt/${SLURM_DIR}
    # Solo purgamos los paquetes de compilación temporales
    apt-get purge -y build-essential wget make gcc
    apt-get autoremove -y
    apt-get clean

    # DOWNLOAD THE VS CODE CLI
    export VSCODE_CLI_TAR="vscode_cli.tar.gz"
    curl -fL --retry 5 --connect-timeout 30 --max-time 900 'https://update.code.visualstudio.com/{{ VSCODE_VERSION }}/cli-linux-x64/stable' --output $VSCODE_CLI_TAR

    # EXTRACT the code executable directly into the root directory (/)
    # The container build process is usually writable at the root during %post
    tar -xzf $VSCODE_CLI_TAR -C /
    
    # VERIFY AND MOVE (The code executable will be at /code)
    mkdir -p /usr/container/bin
    mv /code /usr/container/bin/code
    chmod +x /usr/container/bin/code

    # Record versions, for users and for the release bot.
    echo "vscode=$(/usr/container/bin/code --version | head -1 | awk '{print $2}')" > /etc/ood-image-versions
    cat /etc/ood-image-versions

    #  Clean up
    rm $VSCODE_CLI_TAR
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # Slurm client defaults for commands run inside this container (VS Code
    # terminals launched in the tunnel). Without these, sbatch/salloc/srun
    # default to --export=ALL and leak container-specific paths and variables
    # into cluster jobs, breaking on compute nodes with a different userspace.
    # Mirrors the OOD dashboard container fix (see OnDemandDocker/Dockerfile).
    # Submit identity is unaffected — munge takes it from the Unix UID.
    mkdir -p /etc/profile.d
    cat > /etc/profile.d/slurm-export.sh <<'SLURMEOF'
export SBATCH_EXPORT=NONE
export SBATCH_GET_USER_ENV=60L
export SALLOC_EXPORT=NONE
export SRUN_EXPORT_ENV=NONE
SLURMEOF
    chmod 644 /etc/profile.d/slurm-export.sh

%environment
    export PATH=/usr/container/bin:$PATH
    export PATH=/usr/local/bin:$PATH
    export SBATCH_EXPORT=NONE
    export SBATCH_GET_USER_ENV=60L
    export SALLOC_EXPORT=NONE
    export SRUN_EXPORT_ENV=NONE
    
%runscript
    # The PATH is set, but use the full path just in case
    /usr/container/bin/code tunnel "$@"
