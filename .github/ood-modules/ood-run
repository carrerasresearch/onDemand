#!/bin/bash
# ood-run - submit a command as a Slurm job that runs in the loaded ood module's image.
#
#   module load ood/jupyter
#   ood-run -c 8 --mem 32G -t 4:00:00 -- python analysis.py
#   ood-run --gpu -c 4 --mem 32G -- python train.py       # a GPU node, GPU passed through
#   ood-run --env myenv -c 4 -- python x.py                # in a conda env (Jupyter images)
#   ood-run --print -c 4 -- python x.py > job.sh           # only print the job script
#   ood-run --module ood/rstudio/3.24 -c 4 -- Rscript x.R  # another module than the loaded one
#
# Options before "--" are sbatch options (plus --gpu, --env NAME, --module NAME, --print).
# The job loads the same module and runs the command with ood-exec; its log
# is ood-<jobid>.out in the current folder unless you pass -o.
set -u
OOD_ROOT="${OOD_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
die() { echo "ood-run: $*" >&2; exit 2; }
sb=() envopt=() print="" out="" mod="${OOD_MODULE:-}"
while [[ $# -gt 0 && "$1" != "--" ]]; do
  case "$1" in
    --gpu) sb+=(--gres=gpu:1); [[ -n "${OOD_GPU_PARTITION:-test-gpu}" ]] && sb+=(--partition="${OOD_GPU_PARTITION:-test-gpu}") ;;
    --module) mod="${2:?--module needs a name}"; shift ;;
    --module=*) mod="${1#--module=}" ;;
    --env) envopt=(--env "${2:?--env needs a name}"); shift ;;
    --env=*) envopt=(--env "${1#--env=}") ;;
    --print) print=1 ;;
    -o|--output) out="$2"; sb+=("$1" "$2"); shift ;;
    -o*|--output=*) out=x; sb+=("$1") ;;
    *) sb+=("$1") ;;
  esac
  shift
done
[[ "${1:-}" == "--" ]] && shift
[[ -n "$mod" ]] || die "no ood module: module use $OOD_ROOT/modulefiles; module load ood/jupyter (or pass --module ood/jupyter)"
[[ $# -gt 0 ]] || die "nothing to run; usage: ood-run [sbatch options] -- COMMAND [ARGS]"
[[ -n "$out" ]] || sb+=(--output="ood-%j.out")

script="#!/bin/bash
#SBATCH --job-name=ood-$(basename "$1" | tr -c 'A-Za-z0-9._-' _ | cut -c1-30)
# Generated by ood-run: runs the command in the image of module ${mod}.
[[ \"\$(type -t module)\" == function ]] || source /etc/profile.d/lmod.sh
module use $(printf '%q' "$OOD_ROOT/modulefiles")
module load $(printf '%q' "$mod")
exec ood-exec $(printf '%q ' "${envopt[@]+"${envopt[@]}"}" "$@")
"
if [[ -n "$print" ]]; then
  printf '%s' "$script" | sed "2a #SBATCH $(printf '%q ' "${sb[@]+"${sb[@]}"}")"
  exit 0
fi
printf '%s' "$script" | sbatch "${sb[@]+"${sb[@]}"}"
