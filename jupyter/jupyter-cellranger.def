# JupyterLab + PyTorch + Cell Ranger + the scverse single-cell stack (scanpy,
# anndata, mudata, muon, squidpy, decoupler, LIANA+), for the OnDemand
# "Jupyter Lab" app. /etc/ood-python-packages.txt lists every Python package.
#
# Parameterised version of jupyter-cellranger-gpu-cuda-13.def (which built
# jupyter-cellranger-gpu-cuda-13.sif); .github/release-bot builds new images
# from this file when JupyterLab or PyTorch publish a new minor release.
#
# Build from a directory containing cellranger.tar.gz and cellranger-arc.tar.gz
# (the 10x release tarballs, e.g. /ijc/PUBLIC/DATA/images/cellranger-10.1.0.tar.gz,
# copied under those fixed names):
#   apptainer build --fakeroot \
#     --build-arg JUPYTERLAB_VERSION=4.6.6 --build-arg TORCH_VERSION=2.14.1 \
#     --build-arg TORCHVISION_VERSION=0.29.2 \
#     --build-arg CELLRANGER_VERSION=10.1.0 --build-arg CELLRANGER_ARC_VERSION=2.0.2 \
#     jupyter-cellranger_2026.11.sif /path/to/jupyter/jupyter-cellranger.def
# /opt/cellranger and /opt/cellranger-arc link to the installed versions, so
# the app's PATH does not depend on them.
# Deploy: cp the .sif to /ijc/PUBLIC/DATA/images/ and add it to form.yml and
#   template/script.sh.erb (the release bot does both).
#
# PyTorch wheels from PyPI bundle their own CUDA runtime; the base image only
# provides cuDNN/driver-side libraries. The GPU node's driver (580, CUDA 13.0)
# must support the wheel's CUDA version.

Bootstrap: docker
From: nvidia/cuda:{{ CUDA_TAG }}

%arguments
    CUDA_TAG=13.1.1-cudnn-runtime-ubuntu24.04
    PYTHON_VERSION=3.12
    JUPYTERLAB_VERSION=4.5.4
    TORCH_VERSION=2.10.0
    TORCHVISION_VERSION=0.25.0
    CELLRANGER_VERSION=9.0.1
    CELLRANGER_ARC_VERSION=2.0.2

%files
    ./cellranger.tar.gz /opt/cellranger.tar.gz
    ./cellranger-arc.tar.gz /opt/cellranger-arc.tar.gz

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Etc/UTC

    apt-get update && apt-get install -y wget bzip2 ca-certificates libglib2.0-0 git curl

    cd /opt
    tar -xmf cellranger.tar.gz
    tar -xmf cellranger-arc.tar.gz
    rm cellranger.tar.gz cellranger-arc.tar.gz
    test -x cellranger-{{ CELLRANGER_VERSION }}/cellranger
    test -x cellranger-arc-{{ CELLRANGER_ARC_VERSION }}/cellranger-arc
    ln -s cellranger-{{ CELLRANGER_VERSION }} /opt/cellranger
    ln -s cellranger-arc-{{ CELLRANGER_ARC_VERSION }} /opt/cellranger-arc

    wget -q --timeout=60 --tries=5 https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -O /opt/miniforge.sh
    bash /opt/miniforge.sh -b -p /opt/conda
    rm /opt/miniforge.sh
    export PATH="/opt/conda/bin:$PATH"

    conda create -n jlab-env -y python={{ PYTHON_VERSION }} jupyterlab={{ JUPYTERLAB_VERSION }}
    # PyTorch and the scverse single-cell stack, resolved together so they
    # agree on numpy/numba. uv, because pip's resolver backtracks for a long
    # time on this set. liana[extras] adds its optional methods (muon,
    # omnipath, decoupler, cell2cell/tensorly, mofapy2, pydeseq2, corneto...).
    # It stays in the image: users can use `uv pip install` too.
    /opt/conda/envs/jlab-env/bin/pip install --no-cache-dir uv
    /opt/conda/envs/jlab-env/bin/uv pip install --no-cache --python /opt/conda/envs/jlab-env/bin/python \
        jupyterlab=={{ JUPYTERLAB_VERSION }} \
        torch=={{ TORCH_VERSION }} torchvision=={{ TORCHVISION_VERSION }} numpy \
        "scanpy[leiden]" anndata mudata muon squidpy decoupler "liana[extras]" ipywidgets
    conda clean -afy

    # Packages users install with `pip install --user` (the app points
    # PYTHONUSERBASE at ~/jupyterlab_ood/python-libs) come after the image's,
    # so an old copy there (say numpy 1.x) cannot break the image's stack.
    # Packages the image does not have still load from the user's folder.
    test ! -e /opt/conda/envs/jlab-env/lib/python{{ PYTHON_VERSION }}/site-packages/sitecustomize.py
    cat > /opt/conda/envs/jlab-env/lib/python{{ PYTHON_VERSION }}/site-packages/sitecustomize.py <<'EOF'
"""OnDemand image: the user's pip --user packages come after the image's own."""
import os
import site
import sys

if site.ENABLE_USER_SITE:
    _user = os.path.abspath(site.getusersitepackages())
    _hits = [p for p in sys.path if os.path.abspath(p) == _user]
    for _p in _hits:
        sys.path.remove(_p)
    sys.path.extend(_hits)
EOF

    # Record versions, for users and for the release bot.
    /opt/conda/envs/jlab-env/bin/python - > /etc/ood-image-versions <<'EOF'
import sys, jupyterlab, numpy, torch, torchvision
import anndata, scanpy, squidpy, decoupler, liana
print(f"python={sys.version.split()[0]}")
print(f"jupyterlab={jupyterlab.__version__}")
print(f"torch={torch.__version__}")
print(f"torch_cuda={torch.version.cuda}")
print(f"torchvision={torchvision.__version__}")
print(f"numpy={numpy.__version__}")
print(f"scanpy={scanpy.__version__}")
print(f"anndata={anndata.__version__}")
print(f"squidpy={squidpy.__version__}")
print(f"decoupler={decoupler.__version__}")
print(f"liana={liana.__version__}")
EOF
    # Every Python package in the image, for users.
    /opt/conda/envs/jlab-env/bin/uv pip freeze --python /opt/conda/envs/jlab-env/bin/python > /etc/ood-python-packages.txt
    echo "cellranger=$(/opt/cellranger/cellranger --version | awk '{print $2}' | sed 's/^cellranger-//')" >> /etc/ood-image-versions
    echo "cellranger_arc=$(/opt/cellranger-arc/cellranger-arc --version | awk '{print $2}' | sed 's/^cellranger-arc-//')" >> /etc/ood-image-versions
    cat /etc/ood-image-versions

    # Never clean /tmp here: during `apptainer build` it is the HOST's /tmp.
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH="/opt/cellranger:/opt/cellranger-arc:/opt/conda/envs/jlab-env/bin:/opt/conda/bin:$PATH"
    export CONDA_DEFAULT_ENV="jlab-env"

%runscript
    . /opt/conda/etc/profile.d/conda.sh
    conda activate jlab-env
    exec "$@"
