#!/usr/bin/env bash

source /etc/profile.d/lmod.sh

# Explicitly set the HOME variable at the beginning of the script to be safe.
# The `OOD_HOME` variable is provided by OnDemand for this purpose.
export HOME="${HOME}"

# Load the required environment
setup_env () {
  # Additional environment which could be moved into a module
  # Change these to suit
<%-
  # Version (form.yml bioc_version; the value is the description shown on the
  # session card) => [image, per-user workdir].
  # The workdir holds the R user library, so it must differ per R version.
  # 3.21 and ehmm keep the workdirs of the apps they came from, so existing
  # users keep their packages; 3.21 is the fallback for sessions saved before
  # the version field existed. New Bioconductor releases are added at the top
  # by .github/release-bot.
  images = {
    "Bioconductor 3.24, R 4.6.2, RStudio 2026.11" => ["/ijc/PUBLIC/DATA/images/bioconductor_3.24.sif", "rstudio_server_bioconductor_3.24"],
    "Bioconductor 3.23, R 4.6.1, RStudio 2026.11" => ["/ijc/PUBLIC/DATA/images/bioconductor_3.23.sif", "rstudio_server_bioconductor_3.23"],
    "Bioconductor 3.21, R 4.5.1, RStudio 2025.09" => ["/ijc/PUBLIC/DATA/images/tidyverse_3.21-R-4.5.1.sif", "rstudio_server_tidyverse_321"],
    "EHMM 1.0, Bioconductor 3.11, R 4.0.0, RStudio 1.3" => ["/ijc/PUBLIC/DATA/images/inspect-ehmm-samtools_latest.sif", "rstudio_server_ehmm"],
  }
  # Short values used before the descriptive ones (saved sessions).
  aliases = { "3.23" => "Bioconductor 3.23, R 4.6.1, RStudio 2026.11", "3.21" => "Bioconductor 3.21, R 4.5.1, RStudio 2025.09", "ehmm" => "EHMM 1.0, Bioconductor 3.11, R 4.0.0, RStudio 1.3" }
  default = "Bioconductor 3.21, R 4.5.1, RStudio 2025.09"
  key = aliases.fetch(context.bioc_version.to_s, context.bioc_version.to_s)
  key = default unless images.key?(key)
  image, workdir_name = images[key]
-%>
  export RSTUDIO_SERVER_IMAGE="<%= image %>"
  echo "Version <%= key %>: ${RSTUDIO_SERVER_IMAGE}"
  echo "hostname: `hostname`"
  module load singularity
  module load Python/3.8.5-GCCcore-11.2.0 
} 

setup_env
[[ -f "${OOD_CHECKS:-}" ]] && source "$OOD_CHECKS" && ood_check_image "$RSTUDIO_SERVER_IMAGE"

#
# Start RStudio Server
#

# PAM auth helper used by RStudio
export RSTUDIO_AUTH="${PWD}/bin/auth"

# Temporary directory to be populated with directories to bind-mount in the container
# where writable file systems are necessary. 
workdir="${HOME}/<%= workdir_name %>"
mkdir -p -m 700 $workdir
# R ignores R_LIBS_USER while the directory does not exist (packages installed
# there only after install.packages() asks to create it): create it up front.
mkdir -p "${workdir}/R/user-libs"

# The cluster's Slurm commands (sbatch, srun, ...; jobs start with the node's
# login environment) and ood-host in the RStudio terminal and from R:
# ood_slurm.sh. On any problem RStudio still starts, without them.
OOD_SLURM_BIND=""; OOD_SLURM_PATH=""
[[ -f ./ood_slurm.sh ]] && source ./ood_slurm.sh && ood_slurm_setup "$RSTUDIO_SERVER_IMAGE" "${OOD_SESSION_DIR:-$PWD}"

# R site profile for the sessions (ood-R/Rprofile.site): the image's own, plus
# the "ood" helpers (ood_reinstall_packages()) and, when Posit's package manager
# has them for this image's OS and Bioconductor release, Bioconductor binaries.
OOD_R_DIR="${OOD_SESSION_DIR:-$PWD}/ood-R"
OOD_BIOC_MIRROR=""
<%- bioc = key[/Bioconductor (\d+\.\d+)/, 1] -%>
<%- if bioc -%>
# Checked from inside the image (its CA certificates and curl).
codename="$(singularity exec "$RSTUDIO_SERVER_IMAGE" sh -c '. /etc/os-release; echo "$VERSION_CODENAME"' 2>/dev/null)"
if [[ -n "$codename" ]] && singularity exec "$RSTUDIO_SERVER_IMAGE" curl -fsI -m 8 -o /dev/null \
     "https://p3m.dev/bioconductor/__linux__/${codename}/latest/packages/<%= bioc %>/bioc/src/contrib/PACKAGES" 2>/dev/null; then
  OOD_BIOC_MIRROR="https://p3m.dev/bioconductor/__linux__/${codename}/latest"
  echo "Bioconductor <%= bioc %> binaries for ${codename}: ${OOD_BIOC_MIRROR}"
fi
<%- end -%>

# Bindings
export SINGULARITY_BINDPATH="${workdir}/run:/run,${workdir}/database.conf:/etc/rstudio/database.conf,${workdir}/rsession.sh:/etc/rstudio/rsession.sh,${workdir}/var/lib/rstudio-server:/var/lib/rstudio-server,/ijc:/ijc${OOD_SLURM_BIND:+,$OOD_SLURM_BIND}"

mkdir -p -m 700 ${workdir}/run ${workdir}/tmp ${workdir}/var/lib/rstudio-server
cat > ${workdir}/database.conf <<END
provider=sqlite
directory=/var/lib/rstudio-server
END

# Generate an `rsession` wrapper script
export RSESSION_WRAPPER_FILE="${workdir}/rsession.sh"
(
umask 077
sed 's/^ \{2\}//' > "${RSESSION_WRAPPER_FILE}" << EOL
  #!/usr/bin/env bash

  # Log all output from this script
  export RSESSION_LOG_FILE="${workdir}/rsession.log"

  exec &>>"\${RSESSION_LOG_FILE}"

  # Add R's shared library path to LD_LIBRARY_PATH
  export LD_LIBRARY_PATH="/usr/local/lib/R/lib"
  
  export R_LIBS_USER=${workdir}/R/user-libs
  [ -f "${OOD_R_DIR}/Rprofile.site" ] && export R_PROFILE="${OOD_R_DIR}/Rprofile.site" OOD_R_HELPERS="${OOD_R_DIR}/ood.R" OOD_BIOC_MIRROR="${OOD_BIOC_MIRROR}"
  ${OOD_SLURM_PATH:+export PATH="${OOD_SLURM_PATH}:\$PATH"}
  # The host's \`module\` would load cluster modules into the container and
  # could break R; the one on PATH (ood_slurm.sh) offers the tested ones.
  unset -f module ml 2>/dev/null

  # Launch the original command
  echo "Launching rsession..."
  set -x
  exec /usr/lib/rstudio-server/bin/rsession --r-libs-user "\${R_LIBS_USER}" "\${@}"
EOL
)
chmod 700 "${RSESSION_WRAPPER_FILE}"

# Do not suspend idle sessions.
# Alternative to setting session-timeout-minutes=0 in /etc/rstudio/rsession.conf
export SINGULARITYENV_RSTUDIO_SESSION_TIMEOUT=0
export SINGULARITYENV_USER=$(id -un)

# Set working directory to home directory
cd "${HOME}"

export TMPDIR="$(mktemp -d)"

mkdir -p "$TMPDIR/rstudio-server"
python3 -c 'from uuid import uuid4; print(uuid4())' > "$TMPDIR/rstudio-server/secure-cookie-key"
chmod 0600 "$TMPDIR/rstudio-server/secure-cookie-key"

set -x
# Launch the RStudio Server
echo "Starting up rserver..."


user=$(whoami)

echo "${user}"

singularity run -B "$TMPDIR:/tmp" "$RSTUDIO_SERVER_IMAGE" \
 /usr/lib/rstudio-server/bin/rserver \
 --www-port "${port}" \
 --auth-none=1 \
 --server-user="${user}" \
 --auth-pam-helper-path "${RSTUDIO_AUTH}" \
 --auth-encrypt-password 0 \
 --rsession-path "${RSESSION_WRAPPER_FILE}"

echo 'Singularity as exited...'
