---
batch_connect:
  template: "basic"
script:
  copy_environment: no
  native:
<%- v = bioc_version.to_s.empty? ? "3.21" : bioc_version.to_s -%>
    - "--job-name=<%= v == "ehmm" ? "ood_rstudio_ehmm" : "ood_rstudio_bioconductor_#{v.delete(".")}" %>"
    - "--cpus-per-task=<%= custom_cpus %>"
    - "--mem=<%= memory %>G"
    - "--time=<%= bc_num_hours %>:00:00"  
    - "--partition=test2"
